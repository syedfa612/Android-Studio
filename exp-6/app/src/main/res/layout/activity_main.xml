<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- App Header / Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Experiment 6: Basic Views App"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Course Registration Portal"
            android:textSize="14sp"
            android:textColor="#5F6368"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <!-- Student Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textStyle="bold"
                android:textColor="#202124"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter full name"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="12dp"/>

            <!-- Student USN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student USN"
                android:textStyle="bold"
                android:textColor="#202124"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etStudentUsn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter USN (e.g. 1RV21CS001)"
                android:inputType="textCapCharacters"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="12dp"/>

            <!-- Gender Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textStyle="bold"
                android:textColor="#202124"
                android:layout_marginBottom="4dp"/>

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Male"
                    android:layout_marginEnd="24dp"/>

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Female"/>
            </RadioGroup>

            <!-- Course Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Course"
                android:textStyle="bold"
                android:textColor="#202124"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerCourse"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="16dp"/>

            <!-- Notifications Checkbox -->
            <CheckBox
                android:id="@+id/cbNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receive email notifications for classes"
                android:layout_marginBottom="16dp"/>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Registration"
                android:backgroundTint="#1A73E8"
                android:textColor="@android:color/white"
                android:padding="12dp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Output Result Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registration Summary Output"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1A73E8"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fill out the form above and click Submit Registration to see details here."
                android:textSize="14sp"
                android:textColor="#3c4043"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
