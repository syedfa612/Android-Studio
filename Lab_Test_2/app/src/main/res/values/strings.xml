    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_description">QRVault is a contact sharing app. It fetches contacts through the Android Contacts Content Provider, encodes the selected contact as a vCard 3.0 QR code with ZXing, and keeps a local history in SQLite. QR codes can be saved to your gallery or shared through any installed app.</string>
    <string name="technologies_title">Technologies Used</string>
    <string name="technologies_list">• Kotlin and AndroidX\n• XML layouts with Material Components\n• SQLite (SQLiteOpenHelper, QRVault.db)\n• ContactsContract Content Provider\n• ZXing core for QR generation\n• MediaStore and FileProvider for saving and sharing\n• Android runtime permissions</string>
